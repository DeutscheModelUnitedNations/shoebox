# Copy this file to .env. The defaults below match dev.docker-compose.yml and oidc-mock.yaml,
# so a plain copy is enough for local development.
#
# The same file is read by the server (apps/server, via Vite's envDir), the processor
# (apps/processor) and the database tooling (packages/db).

PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5434/shoebox

# ───────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION (OIDC)
# ───────────────────────────────────────────────────────────────────────────────
# Any OpenID Connect provider works. Local development uses oidc-mock, which runs inside
# `vite dev`; its users live in apps/server/oidc-mock.yaml.
#
# Logto setup:
#   1. Create a "Traditional Web" application
#   2. Redirect URI: <origin>/auth/login-callback, post sign-out URI: <origin>/auth/logout-callback
#   3. App ID → PUBLIC_OIDC_CLIENT_ID, App Secret → OIDC_CLIENT_SECRET

# [REQUIRED] OIDC discovery URL
PUBLIC_OIDC_AUTHORITY=http://127.0.0.1:8090/oidc/.well-known/openid-configuration
# [REQUIRED] OAuth2 client ID
PUBLIC_OIDC_CLIENT_ID=shoebox
# [REQUIRED for confidential clients]
# OIDC_CLIENT_SECRET=
# [OPTIONAL] Scopes requested from the provider
# OIDC_SCOPES=openid profile email offline_access
# [OPTIONAL] Callback routes the provider redirects back to (defaults shown)
# PUBLIC_OIDC_LOGIN_CALLBACK_ROUTE=/auth/login-callback
# PUBLIC_OIDC_LOGOUT_CALLBACK_ROUTE=/auth/logout-callback

# ───────────────────────────────────────────────────────────────────────────────
# ACCESS CONTROL
# ───────────────────────────────────────────────────────────────────────────────
# Comma-separated lists. Team members see team-private media. Admins manage everything and
# grant per-conference editing rights. Admins are always team members.
TEAM_EMAIL_WHITELIST=
TEAM_DOMAIN_WHITELIST=dmun.de
ADMIN_EMAIL_WHITELIST=admin@dmun.de
ADMIN_DOMAIN_WHITELIST=

# ───────────────────────────────────────────────────────────────────────────────
# OBJECT STORAGE (S3)
# ───────────────────────────────────────────────────────────────────────────────
# Any S3-compatible endpoint. Local development uses Garage from dev.docker-compose.yml.
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_ACCESS_KEY_ID=GK5h0eb0xdev000000000000000
S3_SECRET_ACCESS_KEY=5h0eb0xdev5h0eb0xdev5h0eb0xdev5h0eb0xdev5h0eb0xdev5h0eb0xdev0000
# Path-style addressing (http://endpoint/bucket/key). Required for Garage and MinIO, off for AWS.
S3_FORCE_PATH_STYLE=true
# Private bucket for uploaded originals, served via presigned URLs.
S3_BUCKET_ORIGINALS=shoebox-originals
# Public bucket for thumbnails and previews, served directly from PUBLIC_MEDIA_BASE_URL.
S3_BUCKET_DERIVATIVES=shoebox-derivatives
# Public base URL of the derivatives bucket (CDN or the bucket's website endpoint).
PUBLIC_MEDIA_BASE_URL=http://shoebox-derivatives.web.localhost:3902

# ───────────────────────────────────────────────────────────────────────────────
# PROCESSOR
# ───────────────────────────────────────────────────────────────────────────────
# PROCESSOR_CONCURRENCY=2
# PROCESSOR_POLL_INTERVAL_MS=5000
# PROCESSOR_STALE_JOB_MS=600000
# PROCESSOR_HEALTH_PORT=3001
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# ───────────────────────────────────────────────────────────────────────────────
# DEV ONLY
# ───────────────────────────────────────────────────────────────────────────────
# Origins allowed by the CORS rules that scripts/dev/bootstrap-s3.ts puts on the dev buckets.
DEV_CORS_ORIGINS=https://localhost:5173,http://localhost:5173

# Behind a reverse proxy see https://svelte.dev/docs/kit/adapter-node#Environment-variables
# ORIGIN=https://gallery.example.org
